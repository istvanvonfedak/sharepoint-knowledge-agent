# sync-worker settings: copy to .env.worker. This is a SEPARATE Entra app registration from the mcp-server's, with
# Graph *application* permissions (see docs/setup.md). Shared settings (database, embeddings) come from .env;
# never put the mcp-server's secret here, and never put this certificate in .env or .env.mcp.
AZURE_TENANT_ID=
SYNC_AZURE_CLIENT_ID=
# PEM with the private key and certificate (docs/setup.md step 7). Docker Compose mounts secrets/sync-worker.pem
# and sets this itself; set it only when running the worker outside Docker.
SYNC_AZURE_CERT_PATH=secrets/sync-worker.pem

# Sites to index: Graph site ids or hostname:/sites/path, comma separated (or use `python -m sync_worker sites add`).
SYNC_SITES=
# With tenant-wide Sites.Read.All the worker can find every site itself instead.
# SYNC_DISCOVER_ALL_SITES=false

# SYNC_CRAWL_INTERVAL_SECONDS=300
# SYNC_DISCOVER_INTERVAL_SECONDS=3600
# SYNC_ACL_SWEEP_INTERVAL_SECONDS=86400
# SYNC_CONCURRENCY=4
# SYNC_MAX_FILE_BYTES=50000000
