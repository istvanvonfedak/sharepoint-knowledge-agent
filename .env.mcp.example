# mcp-server settings: copy to .env.mcp. The delegated (user sign-in) Entra app; the sync-worker has its own app
# (.env.worker.example) and shared settings live in .env (.env.example). Never put the worker's certificate here.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# Create under App registration > Certificates & secrets > New client secret (use the Value, not the Secret ID)
AZURE_CLIENT_SECRET=
PORT=8080
# Where clients reach the server (OAuth issuer + Entra redirect URI derive from it). Default http://localhost:PORT
# PUBLIC_URL=https://sharepoint-mcp.example.com

# Encrypts Entra refresh tokens and sign-ins in progress. Keep it out of the database and its backups. Generate:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
TOKEN_ENCRYPTION_KEY=
# Hosted MCP clients' OAuth callbacks (loopback URIs are always allowed), comma separated:
# OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback

# sharepoint_ask (the agent) uses Gemini with GEMINI_API_KEY from .env, so it sends text the user may read to
# Google. ASK_MODEL=none turns it off. Another LangChain chat model also works ("<provider>:<model>" plus that
# provider's key, with its langchain-<provider> package installed in the mcp-server image).
# ASK_MODEL=google_genai:gemini-3.8-flash
# ASK_MODEL_KWARGS={"temperature": 0}

# LangSmith tracing of sharepoint_ask: each run's question, tool calls, the SharePoint text it read and its answer
# are sent to LangSmith. Off unless LANGSMITH_TRACING=true. Traces are addressed to an agent and environment; don't
# also set LANGSMITH_PROJECT: with both set, langsmith traces nothing.
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com  (EU: https://eu.api.smith.langchain.com)
# LANGSMITH_API_KEY=
# LANGSMITH_AGENT_ID=sharepoint-ask
# LANGSMITH_AGENT_ENVIRONMENT=local

# "index" (default): our permission-filtered index, filled by the sync-worker. "graph": Microsoft Search, live.
# SEARCH_BACKEND=index
