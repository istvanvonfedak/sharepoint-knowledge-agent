# Shared settings: copy to .env. Docker Compose reads it (--env-file .env) for every service, and both services
# read it when run without Docker. Each Entra app has its own file: .env.mcp (mcp-server) and .env.worker
# (sync-worker). Keep their secrets out of this one.

# ---- Index (Postgres + pgvector). Pick a password; compose sets it on first start of a fresh volume.
POSTGRES_PASSWORD=
# Only used without Docker (compose sets it for the containers).
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5432/sharepoint_rag
# Hidden files whose permissions couldn't be resolved: "hide" (default) or "live_check" (see docs/architecture.md)
# UNRESOLVED_ACL_POLICY=hide

# ---- Gemini: embeddings (inference-server) and sharepoint_ask (mcp-server)
# Shared secret between the services and the inference-server.
INFERENCE_API_KEY=
# Google AI Studio (Gemini API) key: https://aistudio.google.com/apikey. Chunk text leaves your infrastructure.
GEMINI_API_KEY=
# Model of the first index generation (later ones: python -m sharepoint_rag.generations). gemini-embedding-001
# supports 768/1536/3072 dims; 1536 stays under pgvector's 2000-dim HNSW limit. Changing these later has no effect.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
# Without Docker, with python -m inference_server running (otherwise each service embeds in-process with GEMINI_API_KEY):
# INFERENCE_URL=http://localhost:8000
