AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# Create under App registration > Certificates & secrets > New client secret (use the Value, not the Secret ID)
AZURE_CLIENT_SECRET=
PORT=8080

# Google AI Studio (Gemini API) key for embeddings: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-embedding-001 supports 768/1536/3072 dims; 1536 stays under pgvector's 2000-dim HNSW limit.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
# Postgres with the pgvector extension
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sharepoint_rag
