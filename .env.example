# Shared settings: copy to .env. Docker Compose reads it (--env-file .env) for every service, and both services
# read it when run without Docker. Each Entra app has its own file: .env.mcp (mcp-server) and .env.worker
# (sync-worker). Keep their secrets out of this one.

# ---- Index (Postgres + pgvector). Pick a password; compose sets it on first start of a fresh volume.
POSTGRES_PASSWORD=
# Only used without Docker (compose sets it for the containers).
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5432/sharepoint_rag
# Hidden files whose permissions couldn't be resolved: "hide" (default) or "live_check" (see docs/architecture.md)
# UNRESOLVED_ACL_POLICY=hide

# ---- Models: Gemini embeddings (inference-server), OpenAI for sharepoint_ask (mcp-server)
# Shared secret between the services and the inference-server.
INFERENCE_API_KEY=
# Google AI Studio (Gemini API) key: https://aistudio.google.com/apikey. Embeddings, and the agent evals' default
# grader. Chunk text leaves your infrastructure.
GEMINI_API_KEY=
# OpenAI API key: https://platform.openai.com/api-keys. sharepoint_ask's model, and an openai: index generation.
OPENAI_API_KEY=
# Model of the first index generation (later ones: python -m sharepoint_rag.generations), as gemini:<model> (or a
# bare name) or openai:<model>. gemini-embedding-001 supports 768/1536/3072 dims; 1536 stays under pgvector's
# 2000-dim HNSW limit. Changing these later has no effect.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
# One line per PDF on what it is for, added to its chunks' title (docs/architecture.md#search-index); off when unset.
# Turning it on or off re-indexes on the next crawl. Set it for the evals too, or their index is rebuilt without it.
# DOC_CONTEXT_MODEL=openai:gpt-6-luna
# DOC_CONTEXT_MODEL_KWARGS={"reasoning_effort": "low"}
# OpenAI's embedding quota is in tokens per minute; the inference-server stays under this (default 900000).
# OPENAI_EMBED_TOKENS_PER_MINUTE=900000
# Without Docker, with python -m inference_server running (otherwise each service embeds in-process):
# INFERENCE_URL=http://localhost:8000

# ---- LangSmith tracing of embedding (the inference-server): each request's model and token count, so its cost
# shows next to sharepoint_ask's, which .env.mcp traces. No document text is sent; a search query's text is.
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_AGENT_ID=sharepoint-ask
# LANGSMITH_AGENT_ENVIRONMENT=local

# ---- sharepoint_ask's code interpreter (docs/code-interpreter.md)
# off (default) or local: the sandbox service, started with `--profile sandbox`.
ASK_SANDBOX=off
# Shared secret between the mcp-server and the sandbox, e.g. python -c 'import secrets; print(secrets.token_urlsafe(32))'
SANDBOX_API_KEY=
# The sandbox's container runtime: runsc (gVisor, the default). runc on Docker Desktop, for development only.
# SANDBOX_RUNTIME=runc
